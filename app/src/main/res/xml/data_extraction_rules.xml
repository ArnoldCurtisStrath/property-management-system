<?xml version="1.0" encoding="utf-8"?>
<!-- Rules for backup and device to device transfer on Android 12 and above. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
