<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Sahihi is a paper-and-ink app. It stays light on purpose. -->
    <style name="Theme.PropertyManagement" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/paper_surface</item>
        <item name="colorPrimaryContainer">@color/forest_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/paper_surface</item>
        <item name="colorSecondaryContainer">@color/vermilion_soft</item>
        <item name="colorOnSecondaryContainer">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/paper</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/paper</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="materialButtonStyle">@style/Widget.Sahihi.Button</item>
        <item name="textInputStyle">@style/Widget.Sahihi.TextInputLayout</item>
        <item name="materialCardViewStyle">@style/Widget.Sahihi.Card</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.PropertyManagement.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sahihi_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.PropertyManagement</item>
    </style>
</resources>
