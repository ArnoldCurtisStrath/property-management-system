<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.Sahihi.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Owner statement" />

        <TextView
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="The document that keeps the client. Clear, branded, shareable." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sahihi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SAHIHI · OWNER STATEMENT"
                        android:textColor="@color/gold" />

                    <TextView
                        android:id="@+id/statementNumber"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ST-202611-B1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/buildingName"
                    style="@style/TextAppearance.Sahihi.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="Building" />

                <TextView
                    android:id="@+id/statementMeta"
                    style="@style/TextAppearance.Sahihi.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="November 2026 · Prepared for the owner" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/divider_dashed"
                    android:layerType="software" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rent roll" />

                    <TextView
                        android:id="@+id/rentRollValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Collected" />

                    <TextView
                        android:id="@+id/collectedValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arrears" />

                    <TextView
                        android:id="@+id/arrearsValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vacancy loss" />

                    <TextView
                        android:id="@+id/vacancyLossValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/divider_dashed"
                    android:layerType="software" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expenses" />

                    <TextView
                        android:id="@+id/expensesValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expenseLines"
                    style="@style/TextAppearance.Sahihi.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="No expenses this month." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm">

                    <TextView
                        android:id="@+id/feeLabel"
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Management fee (10%)" />

                    <TextView
                        android:id="@+id/feeValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@color/line" />

                <TextView
                    style="@style/TextAppearance.Sahihi.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="NET TO OWNER" />

                <TextView
                    android:id="@+id/netValue"
                    style="@style/TextAppearance.Sahihi.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Ksh 0"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/preparedBy"
                    style="@style/TextAppearance.Sahihi.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="Prepared by My Property Agency" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/Widget.Sahihi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Share statement" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.Sahihi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Done" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
