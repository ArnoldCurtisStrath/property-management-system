<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="@dimen/space_md"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_sahihi_mark" />

        <TextView
            style="@style/TextAppearance.Sahihi.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="SAHIHI"
            android:textColor="@color/gold" />

        <TextView
            style="@style/TextAppearance.Sahihi.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Every shilling, accounted for" />

        <TextView
            android:id="@+id/appVersion"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            style="@style/TextAppearance.Sahihi.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:lineSpacingExtra="3dp"
            android:text="@string/about_description" />

        <TextView
            style="@style/TextAppearance.Sahihi.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="The team" />

        <TextView
            android:id="@+id/teamList"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="6dp" />

        <TextView
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="Group 8 · BBIT Year 3.2 A · Mobile Application Development · 2026" />

        <TextView
            style="@style/TextAppearance.Sahihi.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:gravity="center"
            android:text="BUILT ON KOTLIN, ROOM, VIEWMODEL, LIVEDATA AND WORKMANAGER" />
    </LinearLayout>
</ScrollView>
