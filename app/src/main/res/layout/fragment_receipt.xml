<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.Sahihi.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receipt" />

        <TextView
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Give the tenant their copy. Keep the ledger." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sahihi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SAHIHI · RENT RECEIPT"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/receiptNumber"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SH-2026-0001" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/divider_dashed"
                    android:layerType="software" />

                <TextView
                    style="@style/TextAppearance.Sahihi.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="RECEIVED FROM" />

                <TextView
                    android:id="@+id/tenantName"
                    style="@style/TextAppearance.Sahihi.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Tenant" />

                <TextView
                    android:id="@+id/unitLine"
                    style="@style/TextAppearance.Sahihi.Body.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Building · Unit" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Body.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Period" />

                        <TextView
                            android:id="@+id/periodValue"
                            style="@style/TextAppearance.Sahihi.Money.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="November 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Body.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Date" />

                        <TextView
                            android:id="@+id/dateValue"
                            style="@style/TextAppearance.Sahihi.Money.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-11-24" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Body.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Method" />

                        <TextView
                            android:id="@+id/methodValue"
                            style="@style/TextAppearance.Sahihi.Money.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cash" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Body.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reference" />

                        <TextView
                            android:id="@+id/referenceValue"
                            style="@style/TextAppearance.Sahihi.Money.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_sm"
                        android:paddingBottom="@dimen/space_sm">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Body.Muted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Collected by" />

                        <TextView
                            android:id="@+id/collectorValue"
                            style="@style/TextAppearance.Sahihi.Money.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Me" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_sm"
                    android:background="@drawable/divider_dashed"
                    android:layerType="software" />

                <TextView
                    style="@style/TextAppearance.Sahihi.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="AMOUNT PAID" />

                <TextView
                    android:id="@+id/amountValue"
                    style="@style/TextAppearance.Sahihi.Money.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Ksh 0"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/balanceValue"
                    style="@style/TextAppearance.Sahihi.Body.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Balance after: Ksh 0" />

                <TextView
                    android:id="@+id/stamp"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_stamp"
                    android:fontFamily="@font/dm_mono"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:rotation="-8"
                    android:text="SAHIHI\nVERIFIED"
                    android:textColor="@color/stamp"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.Sahihi.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="Keep this receipt. Every shilling, accounted for."
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            style="@style/Widget.Sahihi.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="Share receipt"
            app:icon="@drawable/ic_share"
            app:iconTint="@color/paper_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneButton"
            style="@style/Widget.Sahihi.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Done" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
