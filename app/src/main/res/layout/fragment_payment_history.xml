<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.Sahihi.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE LEDGER"
            android:textColor="@color/gold" />

        <TextView
            style="@style/TextAppearance.Sahihi.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="Money" />

        <TextView
            android:id="@+id/monthLabel"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="November 2026 · cash in, cash out, what is left." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sahihi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COLLECTED" />

                        <TextView
                            android:id="@+id/collectedValue"
                            style="@style/TextAppearance.Sahihi.Money"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ksh 0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXPENSES" />

                        <TextView
                            android:id="@+id/expensesValue"
                            style="@style/TextAppearance.Sahihi.Money"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ksh 0"
                            android:textColor="@color/danger" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:layout_marginBottom="@dimen/space_md"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NET THIS MONTH" />

                        <TextView
                            android:id="@+id/netValue"
                            style="@style/TextAppearance.Sahihi.Money"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ksh 0"
                            android:textColor="@color/success" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Sahihi.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ARREARS" />

                        <TextView
                            android:id="@+id/arrearsValue"
                            style="@style/TextAppearance.Sahihi.Money"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ksh 0"
                            android:textColor="@color/danger" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mpesaButton"
                style="@style/Widget.Sahihi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="M-Pesa"
                app:icon="@drawable/ic_receipt"
                app:iconTint="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/expenseButton"
                style="@style/Widget.Sahihi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="Add expense"
                app:icon="@drawable/ic_wallet"
                app:iconTint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayCloseButton"
                style="@style/Widget.Sahihi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Day close"
                app:icon="@drawable/ic_check"
                app:iconTint="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/statementButton"
                style="@style/Widget.Sahihi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="Statement"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Sahihi.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Receipts" />

            <TextView
                android:id="@+id/receiptsCount"
                style="@style/TextAppearance.Sahihi.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 THIS MONTH" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/receiptList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/emptyReceipts"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="No receipts yet."
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Sahihi.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expenses" />

            <TextView
                android:id="@+id/expensesTotal"
                style="@style/TextAppearance.Sahihi.Money.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ksh 0" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/expenseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/emptyExpenses"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="No expenses this month."
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Sahihi.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Arrears" />

            <TextView
                android:id="@+id/seeAllArrears"
                style="@style/TextAppearance.Sahihi.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_sm"
                android:text="SEE ALL"
                android:textColor="@color/secondary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/arrearsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/emptyArrears"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Everyone is paid up."
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
