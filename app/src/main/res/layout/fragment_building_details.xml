<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.Sahihi.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUILDING"
                    android:textColor="@color/gold" />

                <TextView
                    android:id="@+id/buildingName"
                    style="@style/TextAppearance.Sahihi.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Building" />
            </LinearLayout>

            <TextView
                android:id="@+id/editButton"
                style="@style/TextAppearance.Sahihi.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_sm"
                android:text="EDIT"
                android:textColor="@color/secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/buildingOwner"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="Owner" />

        <TextView
            android:id="@+id/buildingMeta"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Address · Type" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_hero"
            android:padding="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/netLabel"
                    style="@style/TextAppearance.Sahihi.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NET TO OWNER · NOVEMBER 2026"
                    android:textColor="@color/gold" />

                <TextView
                    android:id="@+id/netAmount"
                    style="@style/TextAppearance.Sahihi.Money.Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="Ksh 0"
                    android:textColor="@color/paper_surface" />

                <TextView
                    android:id="@+id/netDetail"
                    style="@style/TextAppearance.Sahihi.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Collected Ksh 0 · Expenses Ksh 0 · Fee Ksh 0"
                    android:textColor="#C9D6D0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/statementButton"
                    style="@style/Widget.Sahihi.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="Send owner statement"
                    android:textColor="@color/primary"
                    app:backgroundTint="@color/paper_surface"
                    app:icon="@drawable/ic_share"
                    app:iconTint="@color/primary" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Sahihi.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rent roll" />

                    <TextView
                        android:id="@+id/rentRollValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Collected" />

                    <TextView
                        android:id="@+id/collectedValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Arrears" />

                    <TextView
                        android:id="@+id/arrearsValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Occupancy" />

                    <TextView
                        android:id="@+id/occupancyValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Vacancy loss" />

                    <TextView
                        android:id="@+id/vacancyLossValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ksh 0" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs">

                    <TextView
                        style="@style/TextAppearance.Sahihi.Body.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open repairs" />

                    <TextView
                        android:id="@+id/openRepairsValue"
                        style="@style/TextAppearance.Sahihi.Money.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addExpenseButton"
                style="@style/Widget.Sahihi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add expense"
                app:icon="@drawable/ic_wallet"
                app:iconTint="@color/ink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/repairsButton"
                style="@style/Widget.Sahihi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="Open repairs"
                app:icon="@drawable/ic_maintenance"
                app:iconTint="@color/ink" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.Sahihi.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="Visit planner" />

        <FrameLayout
            android:id="@+id/weatherContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Sahihi.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Units" />

            <TextView
                android:id="@+id/addUnitButton"
                style="@style/TextAppearance.Sahihi.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="@dimen/space_sm"
                android:text="ADD UNIT"
                android:textColor="@color/secondary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/unitList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/emptyUnits"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="No units in this building yet. Add the first one."
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.Sahihi.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Expenses" />

            <TextView
                android:id="@+id/expensesTotal"
                style="@style/TextAppearance.Sahihi.Money.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ksh 0" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/expenseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/emptyExpenses"
            style="@style/TextAppearance.Sahihi.Body.Muted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="No expenses this month."
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
