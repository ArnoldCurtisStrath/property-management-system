<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/entryDate"
            style="@style/TextAppearance.Sahihi.Money.Small"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_mono"
            android:text="24 Nov"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entryLabel"
                style="@style/TextAppearance.Sahihi.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/entryMeta"
                style="@style/TextAppearance.Sahihi.Body.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="November 2026"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/entryAmount"
                style="@style/TextAppearance.Sahihi.Money.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ksh 0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/entryBalance"
                style="@style/TextAppearance.Sahihi.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_mono"
                android:letterSpacing="0.02"
                android:text="BAL Ksh 0"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/deleteEntryButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:alpha="0.7"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/muted" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />
</LinearLayout>
