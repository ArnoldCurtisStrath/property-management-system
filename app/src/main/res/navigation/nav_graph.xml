<?xml version="1.0" encoding="utf-8"?>
<!-- The navigation graph of the app. Every screen of the drawer is a
     destination here, and the actions move between them. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.propertymanagementsystem.ui.dashboard.DashboardFragment"
        android:label="@string/menu_dashboard">

        <action
            android:id="@+id/action_dashboard_to_about"
            app:destination="@id/aboutFragment" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.example.propertymanagementsystem.ui.about.AboutFragment"
        android:label="@string/menu_about" />

    <fragment
        android:id="@+id/propertyListFragment"
        android:name="com.example.propertymanagementsystem.ui.properties.PropertyListFragment"
        android:label="@string/menu_properties">

        <action
            android:id="@+id/action_property_list_to_property_form"
            app:destination="@id/propertyFormFragment" />

        <action
            android:id="@+id/action_property_list_to_property_details"
            app:destination="@id/propertyDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/propertyFormFragment"
        android:name="com.example.propertymanagementsystem.ui.properties.PropertyFormFragment"
        android:label="@string/menu_properties" />

    <fragment
        android:id="@+id/propertyDetailsFragment"
        android:name="com.example.propertymanagementsystem.ui.properties.PropertyDetailsFragment"
        android:label="@string/menu_properties">

        <action
            android:id="@+id/action_property_details_to_property_form"
            app:destination="@id/propertyFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantListFragment"
        android:name="com.example.propertymanagementsystem.ui.tenants.TenantListFragment"
        android:label="@string/menu_tenants">

        <action
            android:id="@+id/action_tenant_list_to_tenant_form"
            app:destination="@id/tenantFormFragment" />

        <action
            android:id="@+id/action_tenant_list_to_tenant_details"
            app:destination="@id/tenantDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tenantFormFragment"
        android:name="com.example.propertymanagementsystem.ui.tenants.TenantFormFragment"
        android:label="@string/menu_tenants" />

    <fragment
        android:id="@+id/tenantDetailsFragment"
        android:name="com.example.propertymanagementsystem.ui.tenants.TenantDetailsFragment"
        android:label="@string/menu_tenants">

        <action
            android:id="@+id/action_tenant_details_to_tenant_form"
            app:destination="@id/tenantFormFragment" />

    </fragment>




</navigation>
